[Unit]
Description=Nantral Platform Celery task runner
{% for service in nantral_platform_celery_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in nantral_platform_celery_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
ExecStartPre=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ devture_systemd_docker_base_container_stop_grace_time_seconds }} {{ nantral_platform_celery_identifier }} 2>/dev/null || true'
ExecStartPre=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ nantral_platform_celery_identifier }} 2>/dev/null || true'

ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} create \
                --rm \
                --name={{ nantral_platform_celery_identifier }} \
                --log-driver=none \
                --user={{ nantral_platform_uid }}:{{ nantral_platform_gid }} \
                --cap-drop=ALL \
                --read-only \
                --network={{ nantral_platform_celery_container_network }} \
                --env-file={{ nantral_platform_base_path }}/env \
                --tmpfs=/tmp:rw,noexec,nosuid,size=128m \
                {{ nantral_platform_container_image }} \
                {{ nantral_platform_celery_command }}

{% for network in nantral_platform_celery_container_additional_networks %}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network connect {{ network }} {{ nantral_platform_celery_identifier }}
{% endfor %}

ExecStart={{ devture_systemd_docker_base_host_command_docker }} start --attach {{ nantral_platform_celery_identifier }}

ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ devture_systemd_docker_base_container_stop_grace_time_seconds }} {{ nantral_platform_celery_identifier }} 2>/dev/null || true'
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ nantral_platform_celery_identifier }} 2>/dev/null || true'

Restart=always
RestartSec=30
SyslogIdentifier={{ nantral_platform_celery_identifier }}

[Install]
WantedBy=multi-user.target
