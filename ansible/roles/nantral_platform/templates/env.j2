################
### OPTIONAL ###
################

# GitHub features (eg create issues from website)
GITHUB_USER={{ nantral_platform_github_user }}
GITHUB_TOKEN={{ nantral_platform_github_token }}

# Mapbox key (eg roommates map)
MAPBOX_API_KEY={{ nantral_platform_mapbox_api_key }}

# Discord features (eg admin requests)
DISCORD_TOKEN={{ nantral_platform_discord_token }}
DISCORD_CHANNEL_ID={{ nantral_platform_discord_channel_id }}
DISCORD_ADMIN_MODERATION_WEBHOOK={{ nantral_platform_discord_admin_moderation_webhook }}
DISCORD_BACKUP_STATUS_WEBHOOK={{ nantral_platform_discord_backup_status_webhook }}

# Webpush notifications
WP_ADMIN_EMAIL={{ nantral_platform_webpush_admin_email }}
WP_PUBLIC_KEY={{ nantral_platform_webpush_public_key }}
WP_PRIVATE_KEY={{ nantral_platform_webpush_private_key }}

# Matrix homeserver integration
MATRIX_CLIENT_ID={{ nantral_platform_matrix_client_id }}
MATRIX_CLIENT_TOKEN={{ nantral_platform_matrix_client_token }}
MATRIX_BASE_URL={{ nantral_platform_matrix_base_url }}

#####################
### DOCKER NEEDED ###
#####################

# Postgres database settings
POSTGRES_HOSTNAME={{ nantral_platform_database_hostname }}
POSTGRES_PORT={{ nantral_platform_database_port }}
POSTGRES_USER={{ nantral_platform_database_username }}
POSTGRES_PASSWORD={{ nantral_platform_database_password }}
POSTGRES_DB={{ nantral_platform_database_name }}

# Memcached settings
CACHE_LOCATION={{ nantral_platform_memcached_hostname }}:{{ nantral_platform_memcached_port }}
CACHE_KEY_PREFIX={{ nantral_platform_memcached_key_prefix }}

# Celery settings
CELERY_BROKER_URL=redis://{{ nantral_platform_redis_hostname }}:{{ nantral_platform_redis_port }}

###################
### PROD NEEDED ###
###################

# True if this is the staging server (used for testing, not all features work)
STAGING={{ 'True' if nantral_platform_staging else 'False' }}

# OVH credentials for media files server
OVH_ACCESS_KEY_ID={{ nantral_platform_s3_access_key_id }}
OVH_SECRET_ACCESS_KEY={{ nantral_platform_s3_secret_access_key }}
S3_BUCKET={{ nantral_platform_s3_bucket }}

# OVH infos for private S3 (db backups)
S3_BUCKET_PRIVATE={{ nantral_platform_s3_bucket_private }}

# Django settings
SECRET_KEY={{ nantral_platform_django_secret_key }}
DJANGO_ALLOWED_HOSTS={{ nantral_platform_django_allowed_hosts | join(' ') }}
EMAIL_HOST={{ nantral_platform_email_host }}
EMAIL_PORT={{ nantral_platform_email_port }}
EMAIL_HOST_USER={{ nantral_platform_email_user }}
EMAIL_HOST_PASSWORD={{ nantral_platform_email_password }}
