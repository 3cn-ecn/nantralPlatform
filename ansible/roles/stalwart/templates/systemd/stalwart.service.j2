[Unit]
Description=Stalwart mailserver
{% for service in stalwart_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in stalwart_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
ExecStartPre=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} network disconnect {{ stalwart_proxy_network }} {{ traefik_identifier }} || true'
ExecStartPre=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} network disconnect {{ stalwart_proxy_network }} {{ stalwart_identifier }} || true'
ExecStartPre=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} network rm {{ stalwart_proxy_network }} || true'
ExecStartPre=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ devture_systemd_docker_base_container_stop_grace_time_seconds }} {{ stalwart_identifier }} 2>/dev/null || true'
ExecStartPre=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ stalwart_identifier }} 2>/dev/null || true'

ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} create \
                --rm \
                --name={{ stalwart_identifier }} \
                --log-driver=none \
                --user={{ stalwart_uid }}:{{ stalwart_gid }} \
                --cap-drop=ALL \
                --cap-add=NET_BIND_SERVICE \
                --read-only \
                --network={{ stalwart_container_network }} \
                --env-file={{ stalwart_base_path }}/env \
                --label-file={{ stalwart_base_path }}/labels \
                --tmpfs=/tmp:rw,noexec,nosuid,size=512m \
                --mount type=bind,src={{ stalwart_base_path }}/config.json,dst=/etc/stalwart/config.json \
                --mount type=bind,src={{ stalwart_data_path }},dst=/var/lib/stalwart \
                --mount type=bind,src={{ stalwart_logs_path }},dst=/var/log/stalwart \
{% for volume in stalwart_container_additional_volumes %}
                --mount type={{ volume.type | default('bind' if '/' in volume.src else 'volume') }},src={{ volume.src }},dst={{ volume.dst }}{{ (',' + volume.options) if volume.options | default('') else '' }} \
{% endfor %}
{% for arg in stalwart_container_extra_arguments %}
                {{ arg }} \
{% endfor %}
                {{ stalwart_container_image }} \
{% for arg in stalwart_process_extra_arguments %}
                {{ arg }} \
{% endfor %}

ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network create --subnet {{ stalwart_proxy_network_subnet }} {{ stalwart_proxy_network }}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network connect --ip {{ stalwart_proxy_network_stalwart_ip }} {{ stalwart_proxy_network }} {{ stalwart_identifier }}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network connect --ip {{ stalwart_proxy_network_traefik_ip }} {{ stalwart_proxy_network }} {{ traefik_identifier }}

{% for network in stalwart_container_additional_networks %}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network connect {{ network }} {{ stalwart_identifier }}
{% endfor %}

ExecStart={{ devture_systemd_docker_base_host_command_docker }} start --attach {{ stalwart_identifier }}

ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} network disconnect {{ stalwart_proxy_network }} {{ stalwart_identifier }} || true'
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} network disconnect {{ stalwart_proxy_network }} {{ traefik_identifier }} || true'
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} network rm {{ stalwart_proxy_network }} || true'
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ devture_systemd_docker_base_container_stop_grace_time_seconds }} {{ stalwart_identifier }} 2>/dev/null || true'
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ stalwart_identifier }} 2>/dev/null || true'

Restart=always
RestartSec=30
SyslogIdentifier={{ stalwart_identifier }}

[Install]
WantedBy=multi-user.target
