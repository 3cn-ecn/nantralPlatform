{
  "name": "@3cn-ecn/nantral-platform-emails",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "email dev",
    "build:html": "email export --outDir ../backend/templates/emails/html/",
    "build:txt": "email export --outDir ../backend/templates/emails/text/ --plainText",
    "build": "npm run build:html && npm run build:txt",
    "types": "tsc",
    "lint": "eslint emails",
    "lint:fix": "eslint emails --fix",
    "test": "npm run types && npm run lint"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "6.11.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.20.8",
    "@eslint/js": "^10.0.1",
    "@react-email/ui": "6.11.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/react": "^19.3.0",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
